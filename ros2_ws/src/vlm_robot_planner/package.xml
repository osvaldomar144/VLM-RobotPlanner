<?xml version="1.0"?>
<package format="3">
  <name>vlm_robot_planner</name>
  <version>0.1.0</version>
  <description>VLM-based task planner and execution node for Franka Panda arm</description>
  <maintainer email="o.hidalgomartinez@dxc.com">Alexis Martinez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS 2 runtime -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>action_msgs</depend>

  <!-- Motion planning (moveit_py è incluso in moveit, non ha rosdep key separata) -->
  <depend>moveit_ros_planning_interface</depend>

  <!-- Robot control -->
  <depend>control_msgs</depend>
  <depend>controller_manager</depend>

  <!-- Simulation -->
  <depend>gazebo_msgs</depend>

  <!-- Image processing -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
