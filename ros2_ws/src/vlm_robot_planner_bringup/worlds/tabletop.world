<?xml version="1.0"?>
<!--
  Tabletop manipulation world for VLM-RobotPlanner (Phase 1).
  Scene: Franka Panda arm (spawned separately via launch file) + table + objects.

  Object names match the symbolic names used in PDDL problems:
    red_cup   → red cylinder  (graspable object)
    blue_box  → blue cube     (graspable object)
    shelf_b   → green platform (target location for placement)

  Coordinate convention (robot base = world origin):
    x → forward (away from robot)
    y → left
    z → up

  Table surface at z = 0.77 m (standard IKEA-height worktable).
  Objects placed at reachable positions for the Franka (~0.4–0.65 m from base).
-->
<sdf version="1.6">
  <world name="tabletop">

    <!-- ── Lighting ──────────────────────────────────────────────────────── -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ── Ground plane ─────────────────────────────────────────────────── -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ── Gazebo ROS state plugin ──────────────────────────────────────────
         Exposes /gazebo/get_entity_state service.
         Used by GazeboOracle to query ground-truth object poses at runtime.
    ────────────────────────────────────────────────────────────────────── -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <!-- ── Physics (reduce solver iterations for faster sim) ────────────── -->
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <!-- ── Table ──────────────────────────────────────────────────────────
         Surface: 90 × 60 cm, top at z = 0.77 m
         Centre: 0.5 m in front of robot (x = 0.5)
    ────────────────────────────────────────────────────────────────────── -->
    <model name="table">
      <static>true</static>
      <pose>0.5 0.0 0.0 0 0 0</pose>

      <!-- Surface slab -->
      <link name="surface">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.90 0.60 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.90 0.60 0.04</size></box></geometry>
          <material>
            <ambient>0.55 0.45 0.32 1</ambient>
            <diffuse>0.75 0.62 0.44 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Four legs -->
      <link name="leg_fl">
        <pose>0.40 0.26 0.375 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.04 0.04 0.75</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.04 0.04 0.75</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
      <link name="leg_fr">
        <pose>0.40 -0.26 0.375 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.04 0.04 0.75</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.04 0.04 0.75</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
      <link name="leg_bl">
        <pose>-0.40 0.26 0.375 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.04 0.04 0.75</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.04 0.04 0.75</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
      <link name="leg_br">
        <pose>-0.40 -0.26 0.375 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.04 0.04 0.75</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.04 0.04 0.75</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ── red_cup ────────────────────────────────────────────────────────
         Red cylinder: r=2.5cm, h=12cm → centre at z = 0.77 + 0.06 = 0.83 m
         Radius reduced from 4cm to 2.5cm so that the Panda gripper (8cm gap)
         has 1.5cm clearance per side when approaching from above.
    ────────────────────────────────────────────────────────────────────── -->
    <model name="red_cup">
      <pose>0.50 0.10 0.83 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.10</mass>
          <inertia>
            <ixx>1.4e-4</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.4e-4</iyy><iyz>0</iyz>
            <izz>3.1e-5</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.025</radius><length>0.12</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.025</radius><length>0.12</length></cylinder></geometry>
          <material>
            <ambient>0.90 0.10 0.10 1</ambient>
            <diffuse>0.90 0.10 0.10 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── blue_box ───────────────────────────────────────────────────────
         Blue cube: 6 cm side → centre at z = 0.77 + 0.03 = 0.80 m
    ────────────────────────────────────────────────────────────────────── -->
    <model name="blue_box">
      <pose>0.50 -0.10 0.80 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.10</mass>
          <inertia>
            <ixx>1.0e-4</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.0e-4</iyy><iyz>0</iyz>
            <izz>1.0e-4</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.90 1</ambient>
            <diffuse>0.10 0.10 0.90 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── shelf_b ────────────────────────────────────────────────────────
         Green flat platform (target placement location), 15×15×2 cm.
         Placed to the right of the robot's forward axis.
    ────────────────────────────────────────────────────────────────────── -->
    <model name="shelf_b">
      <static>true</static>
      <pose>0.50 -0.25 0.78 0 0 0</pose>
      <link name="surface">
        <collision name="col">
          <geometry><box><size>0.15 0.15 0.02</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.15 0.15 0.02</size></box></geometry>
          <material>
            <ambient>0.20 0.65 0.20 1</ambient>
            <diffuse>0.20 0.65 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Overview camera: fixed, 3/4 frontal-lateral view of the table ──────
         Position: world (1.0, 0.7, 1.5) — to the right of and slightly past
         the table's far edge, elevated.
         Orientation: rpy = (0, 0.68, -2.19) — looks toward table centre
         (0.5, 0, 0.8).  Optical-axis formula: (cos(yaw)*cos(pitch),
         sin(yaw)*cos(pitch), -sin(pitch)) → (-0.45, -0.63, -0.63) ✓

         Why this position vs straight-down:
           - Objects in foreground (x≈0.5), arm base in background (x≈0.2)
             → arm never occludes objects regardless of joint config.
           - y=0.7 offset puts arm (y≈0) to the left of frame centre,
             objects (y=-0.25…+0.10) in right-centre → spatially separated.
           - 3/4 perspective gives VLM better depth/layout understanding
             than pure top-down view.

         Phase 2+: replace with eye-in-hand RealSense D435i after look_at().
         Topic: /overview_camera/image_raw  (640×480, 10 Hz)
    ──────────────────────────────────────────────────────────────────────── -->
    <model name="overview_camera">
      <static>true</static>
      <pose>1.0 0.7 1.5 0 0.68 -2.19</pose>
      <link name="camera_link">
        <visual name="vis">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
        </visual>
        <sensor name="overview_camera" type="camera">
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>5.0</far></clip>
          </camera>
          <plugin name="overview_camera_plugin" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=/overview_camera/image_raw</remapping>
              <remapping>~/camera_info:=/overview_camera/camera_info</remapping>
            </ros>
            <camera_name>overview_camera</camera_name>
            <frame_name>overview_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
