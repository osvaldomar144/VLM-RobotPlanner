<?xml version="1.0"?>
<!--
  Kitchen - cucina attrezzata.
  Bancone 200cm (Y) x 80cm (X) davanti al robot (+x), superficie z=0.770.
  Robot base (panda_link0): (0.20, 0, 0.770).
  Oggetti pickable: tea_box, glass, glass2, cup, can, plate, mug, spoon, knife
  Primitive supportate: pick, place, pour, stir, cut
-->
<sdf version="1.6">
  <world name="kitchen">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <plugin name="model_attachment"
            filename="libboeing_gazebo_model_attachment_plugin_lib.so"/>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode><solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver></ode>
    </physics>

    <!-- ================================================================
         STRUTTURA AMBIENTE
         Stanza 8x8m. Nessun soffitto (visibilita Gazebo dall'alto).
         Layout:
           +x: bancone di lavoro (davanti al robot)
           +y: zona sosta (tavolo, sedie)
           -y: frigorifero, dispensa
           back (+x > 2): parete cucina con pensili
    ================================================================ -->

    <model name="floor"><static>true</static><pose>0 0 0.001 0 0 0</pose>
      <link name="s">
        <visual name="v"><geometry><box><size>18 18 0.002</size></box></geometry>
          <material><ambient>0.72 0.65 0.58 1</ambient><diffuse>0.78 0.70 0.63 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parete posteriore (dietro bancone, x+) -->
    <model name="wall_back"><static>true</static><pose>-4.83 0 1.5 0 0 0</pose>
      <link name="s">
        <collision name="c"><geometry><box><size>0.08 10.0 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.08 10.0 3.0</size></box></geometry>
          <material><ambient>0.92 0.90 0.87 1</ambient><diffuse>0.95 0.93 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Parete sinistra (+y) -->
    <model name="wall_left"><static>true</static><pose>0 3.80 1.5 0 0 0</pose>
      <link name="s">
        <collision name="c"><geometry><box><size>10.0 0.08 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.0 0.08 3.0</size></box></geometry>
          <material><ambient>0.88 0.86 0.83 1</ambient><diffuse>0.92 0.90 0.87 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Nessuna parete destra (rimossa), nessuna parete frontale, nessun soffitto: vista libera -->

    <!-- Piedistallo robot -->
    <model name="robot_pedestal"><static>true</static><pose>0.2 0.0 0.0 0 0 0</pose>
      <link name="column"><pose>0 0 0.385 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.22 0.22 0.77</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.22 0.22 0.77</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.40 0.40 0.43 1</diffuse></material></visual>
      </link>
      <link name="base"><pose>0.07 0 0.025 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.40 0.40 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.40 0.40 0.05</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.30 0.30 0.33 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================================
         BANCONE DA LAVORO - 200cm (Y) x 80cm (X), surface z=0.770
         Centro a (0.85, 0, 0).  Front edge x=0.45.  Back edge x=1.25.
    ================================================================ -->
    <model name="counter"><static>true</static><pose>0.85 0.0 0.0 0 0 0</pose>
      <link name="top"><pose>0 0 0.74 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.80 2.00 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="vis"><geometry><box><size>0.80 2.00 0.06</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.90 0.87 0.83 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular></material>
        </visual>
      </link>
      <link name="lfl"><pose> 0.36  0.93 0.37 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.06 0.06 0.74</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.06 0.06 0.74</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient><diffuse>0.50 0.47 0.44 1</diffuse></material></visual>
      </link>
      <link name="lfr"><pose> 0.36 -0.93 0.37 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.06 0.06 0.74</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.06 0.06 0.74</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient><diffuse>0.50 0.47 0.44 1</diffuse></material></visual>
      </link>
      <link name="lbl"><pose>-0.36  0.93 0.37 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.06 0.06 0.74</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.06 0.06 0.74</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient><diffuse>0.50 0.47 0.44 1</diffuse></material></visual>
      </link>
      <link name="lbr"><pose>-0.36 -0.93 0.37 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.06 0.06 0.74</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.06 0.06 0.74</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient><diffuse>0.50 0.47 0.44 1</diffuse></material></visual>
      </link>
      <!-- Alzatina posteriore -->
      <link name="backsplash"><pose>0.38 0 0.86 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.04 2.00 0.24</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 2.00 0.24</size></box></geometry>
          <material><ambient>0.76 0.74 0.70 1</ambient><diffuse>0.82 0.80 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================================
         OGGETTI SUL BANCONE
         Fila anteriore (x=0.62): vicino al robot (42cm dal base)
         Fila posteriore (x=0.92): piu' lontana (72cm dal base)
         y da -0.75 a +0.75  (spacing ~25cm)
    ================================================================ -->

    <!-- FILA ANTERIORE (x=0.62) - sinistra -> destra -->

    <!-- Scatola di te' (tea_box) y=+0.72 - 10x10x15cm, texture tea_pat, chiaramente distinta dalla can -->
    <model name="tea_box">
      <pose>0.62 0.64 0.770 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <pose>0 0 0.075 0 0 0</pose>
        <inertial><mass>0.20</mass>
          <inertia><ixx>5.42e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>5.42e-4</iyy><iyz>0</iyz><izz>3.33e-4</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.1 0.1 0.15</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 0.1 0.15</size></box></geometry>
          <material>
            <script>
              <uri>model://tea_box/materials/scripts</uri>
              <uri>model://tea_box/materials/textures</uri>
              <name>tea_pat</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bicchiere 1 (pour target) y=+0.33 - cup_glass tondo -->
    <model name="glass">
      <pose>0.62 0.33 0.770 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.065 0 0 0</pose>
        <inertial><mass>0.12</mass>
          <inertia><ixx>1.5e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>1.5e-4</iyy><iyz>0</iyz><izz>9.0e-5</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.038</radius><length>0.130</length></cylinder></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://cup_glass/meshes/cup_glass.dae</uri>
            <scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- Bicchiere 2 (duplicato) y=+0.49 - stesso mesh di glass (cup_glass) -->
    <model name="glass2">
      <pose>0.68 0.49 0.770 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.065 0 0 0</pose>
        <inertial><mass>0.12</mass>
          <inertia><ixx>1.5e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>1.5e-4</iyy><iyz>0</iyz><izz>9.0e-5</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.038</radius><length>0.130</length></cylinder></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://cup_glass/meshes/cup_glass.dae</uri>
            <scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- Tazza blu (cup) y=+0.10 -->
    <model name="cup">
      <pose>0.62 0.10 0.770 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.060 0 0 0</pose>
        <inertial><mass>0.15</mass>
          <inertia><ixx>1.8e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>1.8e-4</iyy><iyz>0</iyz><izz>1.0e-4</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.040</radius><length>0.120</length></cylinder></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://cup_blue/meshes/cup1.dae</uri>
            <scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- Lattina (can) y=-0.20 -->
    <model name="can">
      <pose>0.62 -0.20 0.716 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.115 0 0 0</pose>
        <inertial><mass>0.39</mass>
          <inertia><ixx>5.8e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>5.8e-4</iyy><iyz>0</iyz><izz>1.9e-4</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.0302</radius><length>0.1207</length></cylinder></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://coca_cola/meshes/coke.dae</uri>
            <scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- Cucchiaio (stir tool) - box collision flat, inertia corretta -->
    <model name="spoon">
      <pose>0.7233 -0.4335 0.715 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.070 0 0 0</pose>
        <inertial><mass>0.05</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia><ixx>1.4e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>1.0e-5</iyy><iyz>0</iyz><izz>1.4e-4</izz></inertia>
        </inertial>
        <!-- Box collision flat: 2cm x 18cm x 1.6cm - stabile su superfici piane -->
        <collision name="col">
          <geometry><box><size>0.020 0.180 0.016</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <!-- Visual: cilindro orizzontale + testa sferica -->
        <visual name="handle">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.18</length></cylinder></geometry>
          <material><ambient>0.80 0.80 0.84 1</ambient><diffuse>0.88 0.88 0.92 1</diffuse>
          <specular>0.85 0.85 0.85 1</specular></material>
        </visual>
        <visual name="head">
          <pose>0 0.09 0 0 0 0</pose>
          <geometry><sphere><radius>0.018</radius></sphere></geometry>
          <material><ambient>0.80 0.80 0.84 1</ambient><diffuse>0.88 0.88 0.92 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Vassoio target — y=-0.50: reach 2D=0.65m, ben nel workspace Panda (~0.855m max) -->
    <model name="target_tray"><static>true</static>
      <pose>0.627 -0.500 0.770 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.015 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.20 0.22 0.030</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://tray/meshes/tray.dae</uri>
            <scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- FILA POSTERIORE (x=0.95) -->

    <!-- Ciotola (stir container) y=+0.65 - OSRF bowl: cylinder collision, 3.5cm, dinamico -->
    <include>
      <uri>model://bowl</uri>
      <name>mug</name>
      <pose>0.95 0.65 0.770 0 0 0</pose>
    </include>

    <!-- Piatto (cut surface) y=+0.28 -->
    <model name="plate">
      <pose>0.95 0.28 0.770 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.015 0 0 0</pose>
        <inertial><mass>0.30</mass>
          <inertia><ixx>5.0e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>5.0e-4</iyy><iyz>0</iyz><izz>9.0e-4</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.130</radius><length>0.030</length></cylinder></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://plate_1/meshes/plate_1_body.dae</uri>
            <scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- Tagliere (cut surface, static) y=-0.08 -->
    <model name="cutting_board"><static>true</static>
      <pose>0.95 -0.08 0.778 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.20 0.30 0.016</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="vis"><geometry><box><size>0.20 0.30 0.016</size></box></geometry>
          <material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.65 0.45 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Coltello (cut tool) - box collision flat, inertia corretta -->
    <model name="knife">
      <pose>0.9421 -0.4182 0.715 0 0 -1.5958</pose>
      <link name="link">
        <pose>0 0 0.070 0 0 0</pose>
        <inertial><mass>0.12</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia><ixx>4.9e-4</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>1.0e-5</iyy><iyz>0</iyz><izz>4.9e-4</izz></inertia>
        </inertial>
        <!-- Box collision flat: 22mm x 22cm x 16mm - spessore sufficiente per ODE -->
        <collision name="col">
          <geometry><box><size>0.022 0.220 0.016</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="blade">
          <pose>0 0.040 0 0 0 0</pose>
          <geometry><box><size>0.022 0.150 0.004</size></box></geometry>
          <material><ambient>0.80 0.80 0.82 1</ambient><diffuse>0.88 0.88 0.90 1</diffuse>
          <specular>0.95 0.95 0.95 1</specular></material>
        </visual>
        <visual name="handle">
          <pose>0 -0.080 0 0 0 0</pose>
          <geometry><box><size>0.022 0.080 0.014</size></box></geometry>
          <material><ambient>0.25 0.15 0.10 1</ambient><diffuse>0.35 0.22 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Macchina del caffe, fila posteriore (decorazione, non pickable) -->
    <model name="coffee_machine"><static>true</static>
      <pose>1.011 -0.758 0.770 0 0 -3.14159</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.28 0.25 0.35</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://coffee_machine/meshes/body.dae</uri>
            <scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         ARREDO DISTRIBUITO NELLA STANZA

         +y (sinistra):  pensili sopra bancone, poi zona cottura (fornello)
         -y (destra):    frigorifero
         zona centrale:  tavolo e sedie
         x < 0.2:        zona aperta / ingresso
    ================================================================ -->

    <!-- Pensili sopra bancone - montati sulla parete back-left -->
    <model name="wall_cabinet_l"><static>true</static>
      <pose>1.24 0.55 1.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.296 0.608 0.384</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://Wall_Cabinet_24x15M/meshes/Wall_Cabinet_24x15M.dae</uri>
            <scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_cabinet_r"><static>true</static>
      <pose>1.24 -0.55 1.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.296 0.608 0.384</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://Wall_Cabinet_24x15M/meshes/Wall_Cabinet_24x15M.dae</uri>
            <scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- Fornello / piano cottura -->
    <model name="stove"><static>true</static>
      <pose>-3.7513 2.1287 0.0 0 0 -3.1007</pose>
      <link name="body"><pose>0 0 0.42 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.60 0.70 0.84</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.60 0.70 0.84</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.30 0.30 0.33 1</diffuse></material></visual>
      </link>
      <!-- Piano cottura -->
      <link name="top"><pose>0 0 0.85 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.60 0.70 0.02</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.60 0.70 0.02</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular></material></visual>
      </link>
      <!-- Fuochi (cilindri neri) -->
      <link name="b1"><pose>-0.12  0.14 0.87 0 0 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.085</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>
      </link>
      <link name="b2"><pose>-0.12 -0.14 0.87 0 0 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.085</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>
      </link>
      <link name="b3"><pose> 0.12  0.14 0.87 0 0 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.085</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>
      </link>
      <link name="b4"><pose> 0.12 -0.14 0.87 0 0 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.085</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Frigorifero -->
    <model name="fridge"><static>true</static>
      <pose>-3.9212 -1.2194 0.0 0 0 3.0470</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.65 0.70 1.80</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.90 0 0 0</pose>
          <geometry><box><size>0.65 0.70 1.80</size></box></geometry>
          <material><ambient>0.90 0.90 0.92 1</ambient><diffuse>0.93 0.93 0.95 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular></material>
        </visual>
        <visual name="handle_top">
          <pose>-0.34 0 1.30 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.70 0.70 0.70 1</diffuse></material>
        </visual>
        <visual name="handle_bot">
          <pose>-0.34 0 0.60 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.70 0.70 0.70 1</diffuse></material>
        </visual>
