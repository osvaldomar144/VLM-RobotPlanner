    <!-- Lampada sopra bancone -->
    <model name="ceiling_lamp"><static>true</static>
      <pose>0.85 0.0 2.95 0 0 0</pose>
      <link name="base">
        <visual name="shade">
          <geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.85 0.82 0.20 1</ambient><diffuse>0.92 0.89 0.22 1</diffuse>
          <emissive>0.40 0.38 0.08 1</emissive></material>
        </visual>
        <visual name="cord">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         OVERVIEW CAMERA - visuale 3/4 sul bancone da destra-davanti.
         Da calibrare: python3 scripts/calibrate_overview_cam.py -world kitchen
    ================================================================ -->
    <model name="overview_camera">
      <static>true</static>
      <pose>-0.20 -1.80 2.10 0 0.570 1.043</pose>
      <link name="camera_link">
        <visual name="vis">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
        </visual>
        <sensor name="overview_camera" type="camera">
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>1280</width><height>960</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>7.0</far></clip>
          </camera>
          <plugin name="overview_camera_plugin" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=/overview_camera/image_raw</remapping>
              <remapping>~/camera_info:=/overview_camera/camera_info</remapping>
            </ros>
            <camera_name>overview_camera</camera_name>
            <frame_name>overview_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
