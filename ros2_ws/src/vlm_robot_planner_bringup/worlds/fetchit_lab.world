<?xml version="1.0"?>
<!--
  FetchIt! industrial lab world for VLM-RobotPlanner.
  Scene: Franka Panda arm (spawned separately via launch file) +
         heavy steel-frame table + industrial manipulation objects.

  Object names match PDDL symbolic names:
    red_cup            → red cylinder      (graspable)
    blue_box           → blue cube         (graspable)
    shelf_b            → green platform    (placement target)
    gearbox_bottom     → gearbox bottom half (FetchIt! task)
    gearbox_top        → gearbox top half    (FetchIt! task)
    dropoff_box_target → target bin for completed assemblies
    bin_large          → 100mm sorting bin

  Coordinate convention (robot base = world origin):
    x → forward (away from robot)
    y → left
    z → up

  Table surface at z = 0.77 m.
  Robot base at world (x=0.2, y=0, z=0.77) — spawned by launch file.

  Room is provided by the fetchit_simple_env model (rotated 180° to face
  the camera).  NO extra 4-wall room model is added here.
-->
<sdf version="1.6">
  <world name="fetchit_lab">

    <!-- ── Lighting ──────────────────────────────────────────────────────── -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ── Ground plane ─────────────────────────────────────────────────── -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ── Boeing model attachment plugin ──────────────────────────────────
         Creates/destroys physics joints between model links via ROS2 services:
           /gazebo/attach  — create fixed joint (replace GazeboAttach teleport)
           /gazebo/detach  — remove joint
         Eliminates oscillation caused by gravity vs. kinematic update conflict.
    ────────────────────────────────────────────────────────────────────── -->
    <plugin name="model_attachment"
            filename="libboeing_gazebo_model_attachment_plugin_lib.so">
    </plugin>

    <!-- ── Gazebo ROS state plugin ──────────────────────────────────────────
         Exposes /gazebo/get_entity_state service.
         Used by GazeboOracle to query ground-truth object poses at runtime.
    ────────────────────────────────────────────────────────────────────── -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <!-- ── Physics (reduce solver iterations for faster sim) ────────────── -->
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <!-- ── ENVIRONMENT — FetchIt! industrial arena ──────────────────────────
         Rotated 180° so the arena entrance/backdrop faces the overview camera.
         fetchit_simple_env IS the room — no extra walls added.
    ────────────────────────────────────────────────────────────────────── -->
    <include>
      <uri>model://fetchit_simple_env</uri>
      <name>fetchit_env</name>
      <pose>0 0 0 0 0 3.14159</pose>
    </include>

    <!-- ── TABLE — Industrial metal frame (dark steel aesthetic) ────────────
         Heavy steel top 100×70 cm × 5 cm thick.
         Top link pose z = 0.745, half-thickness = 0.025 → top face = 0.770 m ✓
         Four square steel legs 6×6 cm.
    ────────────────────────────────────────────────────────────────────── -->
    <model name="table">
      <static>true</static>
      <pose>0.5 0.0 0.0 0 0 0</pose>
      <!-- Heavy steel top: 100×70cm × 5cm thick -->
      <link name="top">
        <pose>0 0 0.745 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.00 0.70 0.05</size></box></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="vis"><geometry><box><size>1.00 0.70 0.05</size></box></geometry>
          <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.22 0.22 0.25 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
        </visual>
      </link>
      <!-- 4 square steel legs 6×6cm -->
      <link name="leg_fl"><pose>0.45 0.30 0.37 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.06 0.06 0.74</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.06 0.06 0.74</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
      </link>
      <link name="leg_fr"><pose>0.45 -0.30 0.37 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.06 0.06 0.74</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.06 0.06 0.74</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
      </link>
      <link name="leg_bl"><pose>-0.45 0.30 0.37 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.06 0.06 0.74</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.06 0.06 0.74</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
      </link>
      <link name="leg_br"><pose>-0.45 -0.30 0.37 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.06 0.06 0.74</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.06 0.06 0.74</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── red_cup ────────────────────────────────────────────────────────
         Red cylinder: r=2.5cm, h=12cm → centre at z = 0.77 + 0.06 = 0.83 m
         Radius reduced from 4cm to 2.5cm so that the Panda gripper (8cm gap)
         has 1.5cm clearance per side when approaching from above.
    ────────────────────────────────────────────────────────────────────── -->
    <model name="red_cup">
      <pose>0.50 0.10 0.83 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.10</mass>
          <inertia>
            <ixx>1.4e-4</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.4e-4</iyy><iyz>0</iyz>
            <izz>3.1e-5</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.025</radius><length>0.12</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.025</radius><length>0.12</length></cylinder></geometry>
          <material>
            <ambient>0.90 0.10 0.10 1</ambient>
            <diffuse>0.90 0.10 0.10 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── blue_box ───────────────────────────────────────────────────────
         Blue cube: 6 cm side → centre at z = 0.77 + 0.03 = 0.80 m
    ────────────────────────────────────────────────────────────────────── -->
    <model name="blue_box">
      <pose>0.50 -0.10 0.80 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.10</mass>
          <inertia>
            <ixx>1.0e-4</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.0e-4</iyy><iyz>0</iyz>
            <izz>1.0e-4</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.90 1</ambient>
            <diffuse>0.10 0.10 0.90 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── shelf_b ────────────────────────────────────────────────────────
         Green flat platform (target placement location), 15×15×2 cm.
         Placed to the right of the robot's forward axis.
    ────────────────────────────────────────────────────────────────────── -->
    <model name="shelf_b">
      <static>true</static>
      <pose>0.50 -0.25 0.78 0 0 0</pose>
      <link name="surface">
        <collision name="col">
          <geometry><box><size>0.15 0.15 0.02</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.15 0.15 0.02</size></box></geometry>
          <material>
            <ambient>0.20 0.65 0.20 1</ambient>
            <diffuse>0.20 0.65 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── FetchIt! industrial objects ────────────────────────────────────
         Gearbox parts and sorting bins — FetchIt! competition task objects.
         All placed on table surface (z ≈ 0.77 + object half-height + clearance).
         Note: coke_can, cricket_ball, wood_cube are NOT included here.
    ────────────────────────────────────────────────────────────────────── -->
    <!-- gearbox parts from local models -->
    <include><uri>model://gearbox_bottom</uri><name>gearbox_bottom</name><pose>0.60 0.10 0.810 0 0 0</pose></include>
    <include><uri>model://gearbox_top</uri><name>gearbox_top</name><pose>0.55 -0.05 0.810 0 0 0</pose></include>
    <include><uri>model://dropoff_box</uri><name>dropoff_box_target</name><pose>0.65 -0.20 0.790 0 0 0</pose></include>
    <include><uri>model://100mmbin</uri><name>bin_large</name><pose>0.38 0.18 0.810 0 0 0</pose></include>

    <!-- ── Overview camera: fixed, 3/4 frontal-lateral view of the table ──────
         Position: world (1.0, 0.7, 1.5) — to the right of and slightly past
         the table's far edge, elevated.
         Orientation: rpy = (0, 0.68, -2.19) — looks toward table centre
         (0.5, 0, 0.8).  Optical-axis formula: (cos(yaw)*cos(pitch),
         sin(yaw)*cos(pitch), -sin(pitch)) → (-0.45, -0.63, -0.63) ✓

         Why this position vs straight-down:
           - Objects in foreground (x≈0.5), arm base in background (x≈0.2)
             → arm never occludes objects regardless of joint config.
           - y=0.7 offset puts arm (y≈0) to the left of frame centre,
             objects (y=-0.25…+0.10) in right-centre → spatially separated.
           - 3/4 perspective gives VLM better depth/layout understanding
             than pure top-down view.

         Phase 2+: replace with eye-in-hand RealSense D435i after look_at().
         Topic: /overview_camera/image_raw  (640×480, 10 Hz)
    ──────────────────────────────────────────────────────────────────────── -->
    <model name="overview_camera">
      <static>true</static>
      <pose>1.0 0.7 1.5 0 0.68 -2.19</pose>
      <link name="camera_link">
        <visual name="vis">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
        </visual>
        <sensor name="overview_camera" type="camera">
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>5.0</far></clip>
          </camera>
          <plugin name="overview_camera_plugin" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=/overview_camera/image_raw</remapping>
              <remapping>~/camera_info:=/overview_camera/camera_info</remapping>
            </ros>
            <camera_name>overview_camera</camera_name>
            <frame_name>overview_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
